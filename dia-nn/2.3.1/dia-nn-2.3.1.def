Bootstrap: docker
From: ubuntu

%environment
LANG=en_US.UTF-8
LANGUAGE=en_US:en
LC_ALL=en_US.UTF-8

%post
apt-get update && apt-get upgrade -y
apt-get install -y wget unzip libgomp1 locales
locale-gen en_US.UTF-8
update-locale LANG=en_US.UTF-8

wget https://github.com/vdemichev/DiaNN/releases/download/2.0/DIA-NN-2.3.1-Academia-Linux.zip -O DIA-NN-2.3.1-Academia-Linux.zip
unzip DIA-NN-2.3.1-Academia-Linux.zip
chmod -R 775 /diann-2.3.1
